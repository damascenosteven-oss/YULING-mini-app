DEEPSEEK_API_KEY=replace-with-recipient-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Ordinary generation does not require a search API.
COS_SECRET_ID=replace-with-recipient-id
COS_SECRET_KEY=replace-with-recipient-key
COS_BUCKET=replace-with-recipient-bucket
COS_REGION=replace-with-recipient-region
COS_ENDPOINT=
PPT_INVITE_PASSWORD=replace-with-local-invite-password
PPT_SESSION_SECRET=replace-with-at-least-32-random-characters
# Initialize the independent administrator password with the reviewed bootstrap tool.
PPT_ADMIN_PASSWORD_HASH=
PPT_PUBLIC_ORIGIN=https://ppt.example.com
PPT_MODEL_SETTINGS_DIR=/var/lib/yuling-ppt/model-settings
PPT_ENGINE_ROOT=../yuling-ai-ppt
PPT_PYTHON_PATH=
PPT_CHROME_PATH=
PPT_HOST=127.0.0.1
PORT=5000
